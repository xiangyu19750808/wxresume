{
  "name": "wxresume",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.7",
  "scripts": {
    "api:openapi:lint": "node ./scripts/check-openapi.mjs",
    "dev": "pnpm -C apps/api dev",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm test:unit",
    "test:unit": "pnpm --filter @wxresume/api run pretest && pnpm --filter @wxresume/api test",
    "test:e2e": "./scripts/test-e2e.sh"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
