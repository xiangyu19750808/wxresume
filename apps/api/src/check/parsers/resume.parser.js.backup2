import fs from 'fs';
import path from 'path';

export async function parseResumeFromFile(filePath, mimeType) {
  const buffer = fs.readFileSync(filePath);
  
  // 方法1: 使用file-type检测真实MIME类型
  const fileType = await detectFileType(buffer);
  const actualMime = fileType?.mime || mimeType;
  
  // 文本编码检测
  const encoding = detectEncoding(buffer);
  
  // 根据文件类型选择解析器
  if (actualMime === 'application/pdf') {
    return await parsePDF(buffer, encoding);
  } else if (actualMime === 'application/vnd.openxmlformats-officedocument.wordprocessingml.document') {
    return await parseDOCX(buffer, encoding);
  } else if (actualMime === 'application/msword' || path.extname(filePath).toLowerCase() === '.doc') {
    return await parseDOC(buffer, encoding);
  } else {
    // 其他文本文件
    return parseText(buffer, encoding);
  }
}

async function detectFileType(buffer) {
  try {
    const { fileTypeFromBuffer } = await import('file-type');
    return await fileTypeFromBuffer(buffer);
  } catch (err) {
    console.warn('[resume.parser] file-type detection failed:', err.message);
    return null;
  }
}

async function detectEncoding(buffer) {
  try {
    const jschardet = await import('jschardet');
    const detected = jschardet.detect(buffer);
    return detected.encoding || 'utf-8';
  } catch (err) {
    console.warn('[resume.parser] encoding detection failed:', err.message);
    return 'utf-8';
  }
} catch (err) {
    console.warn('[resume.parser] encoding detection failed:', err.message);
    return 'utf-8';
  }
}

async function parsePDF(buffer, encoding) {
  // 方法1: 尝试pdf-parse (更轻量)
  try {
    const pdfModule = await import('pdf-parse');
    const pdf = pdfModule.default || pdfModule;
    const result = await pdf(buffer);
    if (result.text && result.text.length > 100) {
      return normalizeResumeText(result.text);
    }
  } catch (err) {
    console.warn('[resume.parser] pdf-parse failed, trying pdfjs-dist:', err.message);
  }
  
  // 方法2: 尝试pdfjs-dist (更强大)
  try {
    const pdfjsLib = await import('pdfjs-dist/legacy/build/pdf.mjs');
    const pdfjsWorker = await import('pdfjs-dist/legacy/build/pdf.worker.mjs');
    
    // 设置worker
    pdfjsLib.GlobalWorkerOptions.workerSrc = pdfjsWorker.default || pdfjsWorker;
    
    // 加载PDF文档
    const loadingTask = pdfjsLib.getDocument({ data: buffer });
    const pdfDocument = await loadingTask.promise;
    
    let fullText = '';
    
    // 逐页提取文本
    for (let pageNum = 1; pageNum <= pdfDocument.numPages; pageNum++) {
      const page = await pdfDocument.getPage(pageNum);
      const textContent = await page.getTextContent();
      const pageText = textContent.items
        .map(item => item.str)
        .join(' ');
      fullText += pageText + '\n';
    }
    
    return normalizeResumeText(fullText);
  } catch (err) {
    console.warn('[resume.parser] pdfjs-dist also failed:', err.message);
    // 最后尝试直接解码
    return parseText(buffer, encoding);
  }
}

async function parseDOCX(buffer, encoding) {
  try {
    const mammoth = await import('mammoth');
    const result = await mammoth.extractRawText({ buffer });
    return normalizeResumeText(result.value || '');
  } catch (err) {
    console.warn('[resume.parser] docx parsing failed:', err.message);
    return parseText(buffer, encoding);
  }
}

async function parseDOC(buffer, encoding) {
  // 方法1: 使用textract (如果安装成功)
  try {
    const textract = require('textract');
    return await new Promise((resolve, reject) => {
      textract.fromBufferWithMime('application/msword', buffer, (error, text) => {
        if (error) {
          reject(error);
        } else {
          resolve(normalizeResumeText(text));
        }
      });
    });
  } catch (err) {
    console.warn('[resume.parser] textract for .doc failed:', err.message);
    
    // 方法2: 尝试作为二进制文本解析
    try {
      // 尝试不同的编码
      const encodings = ['utf-8', 'gbk', 'gb2312', 'latin1'];
      for (const enc of encodings) {
        try {
          const text = buffer.toString(enc);
          if (text && text.length > 50 && /[\u4e00-\u9fa5]|[a-zA-Z]/.test(text)) {
            return normalizeResumeText(text);
          }
        } catch (e) {
          continue;
        }
      }
    } catch (err2) {
      console.warn('[resume.parser] binary decode failed:', err2.message);
    }
    
    // 方法3: 返回空文本
    return '';
  }
}

function parseText(buffer, encoding) {
  try {
    // 尝试指定的编码
    const text = buffer.toString(encoding);
    if (text && text.length > 0) {
      return normalizeResumeText(text);
    }
  } catch (err) {
    console.warn('[resume.parser] parse with encoding failed:', err.message);
  }
  
  // 回退到utf-8
  try {
    return normalizeResumeText(buffer.toString('utf-8'));
  } catch (err) {
    console.warn('[resume.parser] utf-8 decode failed:', err.message);
    return '';
  }
}

export function normalizeResumeText(raw) {
  return (raw || '')
    .replace(/\r\n/g, '\n')
    .replace(/\r/g, '\n')
    .replace(/\t/g, ' ')
    .replace(/[ ]{2,}/g, ' ')
    .replace(/[\u0000-\u001F\u007F]/g, '')
    .replace(/\n{3,}/g, '\n\n')
    .trim();
}

export function fromPlainText(raw) {
  return normalizeResumeText(raw || '');
}

export class ResumeParser {
  parse(resumeText) {
    return { sections: [], raw: normalizeResumeText(resumeText) };
  }
}

