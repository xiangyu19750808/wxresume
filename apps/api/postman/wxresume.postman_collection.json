    {
      "name": "auth.wx.callback (mock)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1/auth/wx/callback?code=abc123"
      }
    },
    {
      "name": "users.me (JWT)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/v1/users/me"
      }
    },
    {
      "name": "order.create",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"plan\":\"basic\",\"amount\":1990}"
        },
        "url": "{{baseUrl}}/v1/order/create"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let json = {};",
              "try { json = pm.response.json(); } catch (e) { json = {}; }",
              "const outTradeNo = json?.data?.out_trade_no || json?.out_trade_no || '';",
              "if (outTradeNo) {",
              "  pm.collectionVariables.set('out_trade_no', outTradeNo);",
              "  console.log('set out_trade_no', outTradeNo);",
              "} else {",
              "  console.warn('order.create response missing out_trade_no');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "order.status",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1/order/status?out_trade_no={{out_trade_no}}"
      }
    },
    {
      "name": "order.callback (mock)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Wechatpay-Signature",
            "value": "{{wxpaySignature}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"out_trade_no\":\"{{out_trade_no}}\",\"result\":\"SUCCESS\",\"amount\":1990}"
        },
        "url": "{{baseUrl}}/v1/order/callback"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('wxpaySignature')) {",
              "  pm.collectionVariables.set('wxpaySignature', 'wxpay-fake-signature');",
              "}",
              "if (!pm.collectionVariables.get('out_trade_no')) {",
              "  console.warn('out_trade_no not set; run order.create first');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "order.callback replay (mock)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const baseUrl = pm.collectionVariables.get('baseUrl') || pm.environment.get('baseUrl');",
              "const sig = pm.collectionVariables.get('wxpaySignature') || 'wxpay-fake-signature';",
              "const outTradeNo = pm.collectionVariables.get('out_trade_no');",
              "if (!outTradeNo) {",
              "  console.warn('order.callback replay skipped: missing out_trade_no variable');",
              "  return;",
              "}",
              "const body = JSON.stringify({ out_trade_no: outTradeNo, result: 'SUCCESS', amount: 1990 });",
              "const requestOptions = {",
              "  url: `${baseUrl}/v1/order/callback`,",
              "  method: 'POST',",
              "  header: {",
              "    'Content-Type': 'application/json',",
              "    'Wechatpay-Signature': sig",
              "  },",
              "  body: { mode: 'raw', raw: body }",
              "};",
              "pm.sendRequest(requestOptions, (err, res) => {",
              "  if (err) { console.error('replay#1 failed', err); return; }",
              "  console.log('replay#1', res.json());",
              "  pm.sendRequest(requestOptions, (err2, res2) => {",
              "    if (err2) { console.error('replay#2 failed', err2); return; }",
              "    console.log('replay#2', res2.json());",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Wechatpay-Signature",
            "value": "{{wxpaySignature}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"out_trade_no\":\"{{out_trade_no}}\",\"result\":\"SUCCESS\",\"amount\":1990}"
        },
        "url": "{{baseUrl}}/v1/order/callback"
      }
    },
